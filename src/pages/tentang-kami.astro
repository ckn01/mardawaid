---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import TeamGrid from '../components/TeamGrid.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { getSite } from '../utils/site';
import team from '../data/team.json';
import maps from '../data/maps.json';

const site = getSite();
---
<BaseLayout title="Tentang Kami" description={site.description}>
  <PageHero title="Tentang Kami" subtitle={site.tagline} />
  <section class="py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary">Tentang Kami</p>
      <h2 class="mt-2 text-2xl font-semibold md:text-3xl">Siapa Kami</h2>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-sand-12/70 md:text-lg">
        {site.description}
      </p>
    </div>
  </section>
  <TeamGrid items={team} />
  <section class="py-16 md:py-20 bg-sand-2">
    <div class="mx-auto max-w-6xl px-4">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary">Lokasi</p>
      <h2 class="mt-2 text-2xl font-semibold md:text-3xl">Kantor & Workshop</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {maps.map((m) => (
          <MapEmbed title={m.title} alamat={m.alamat} src={m.src} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
