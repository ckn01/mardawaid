---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import TeamGrid from '../components/TeamGrid.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { getSite } from '../utils/site';
import team from '../data/team.json';
import maps from '../data/maps.json';

const site = getSite();
---
<BaseLayout title="Tentang Kami" description={site.description}>
  <PageHero title="Tentang Kami" subtitle={site.tagline} />

  <section class="section">
    <div class="container-site">
      <p class="section-label">Profil</p>
      <h2 class="section-title">Siapa kami</h2>
      <p class="mt-5 max-w-[var(--measure)] text-[var(--text-lg)] leading-relaxed text-[var(--color-ink-2)]">
        {site.description}
      </p>
    </div>
  </section>

  <TeamGrid items={team} />

  <section class="section bg-[var(--color-paper-2)]">
    <div class="container-site">
      <p class="section-label">Lokasi</p>
      <h2 class="section-title">Kantor & workshop</h2>
      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {maps.map((m) => (
          <MapEmbed title={m.title} alamat={m.alamat} src={m.src} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
