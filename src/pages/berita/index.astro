---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('berita', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---
<BaseLayout title="Berita" description="Berita dan pengumuman PT. Mardawa Intiguna Persada.">
  <PageHero
    title="Berita"
    subtitle="Kabar dan pengumuman terbaru dari Mardawa."
  />
  <section class="section">
    <div class="container-site">
      {
        posts.length === 0 ? (
          <EmptyState
            title="Belum ada berita"
            body="Berita dan pengumuman akan ditampilkan di sini."
          />
        ) : (
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((p) => (
              <ArticleCard
                title={p.data.title}
                href={`/berita/${p.id}`}
                description={p.data.description}
                date={p.data.publishDate.toISOString().slice(0, 10)}
                kategori={p.data.kategori}
              />
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
