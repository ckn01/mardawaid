---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SitePreview from '../../components/SitePreview.astro';
import products from '../../data/products.json';
import { waLink } from '../../utils/site';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product } = Astro.props;

const typeLabel: Record<string, string> = {
  sistem: 'Sistem informasi',
  aplikasi: 'Aplikasi',
  'web-sekolah': 'Web sekolah',
};
const label = product.type ? typeLabel[product.type] : null;
const related = products.filter((p) => p.slug !== product.slug && p.type === product.type).slice(0, 3);
const highlights = 'highlights' in product && Array.isArray(product.highlights) ? product.highlights : [];
---
<BaseLayout title={product.name} description={product.description}>
  <PageHero title={product.name} subtitle={label ?? undefined} />
  <article class="section">
    <div class="container-site">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="min-w-0 lg:col-span-7">
          <div class="prose max-w-none">
            <p>{product.description}</p>
          </div>

          {
            highlights.length > 0 && (
              <div class="mt-8">
                <h2 class="text-sm font-semibold tracking-tight text-[var(--color-ink)]">Ringkasan</h2>
                <ul class="mt-3 space-y-2">
                  {highlights.map((h) => (
                    <li class="flex gap-3 text-sm leading-relaxed text-[var(--color-ink-2)]">
                      <span class="mt-2 size-1.5 shrink-0 rounded-full bg-[var(--brand)]" aria-hidden="true" />
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <div class="mt-10 flex flex-wrap items-center gap-4">
            <a
              href={waLink(`Halo Admin Mardawa, saya tertarik dengan ${product.name}.`)}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              Tanya tentang produk ini
            </a>
            <a href="/produk" class="card-link">← Semua produk</a>
          </div>
        </div>

        <aside class="min-w-0 lg:col-span-5">
          {
            product.url ? (
              <SitePreview url={product.url} title={product.name} />
            ) : (
              <div class="rounded-[var(--radius-card)] border border-[var(--color-rule)] bg-[var(--sand-2)] p-6">
                <p class="font-mono text-[0.65rem] uppercase tracking-[0.08em] text-[var(--sand-9)]">
                  Kategori
                </p>
                <p class="mt-2 text-lg font-semibold tracking-tight text-[var(--sand-12)]">
                  {label ?? 'Produk'}
                </p>
                <p class="mt-3 text-sm leading-relaxed text-[var(--sand-11)]">
                  Ingin demo atau studi kasus serupa? Hubungi tim kami.
                </p>
              </div>
            )
          }
        </aside>
      </div>

      {
        related.length > 0 && (
          <div class="mt-16 border-t border-[var(--color-rule)] pt-12">
            <h2 class="section-title text-xl">Produk terkait</h2>
            <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {related.map((r) => (
                <li>
                  <a href={`/produk/${r.slug}`} class="card block no-underline hover:border-[color-mix(in_srgb,var(--brand)_28%,var(--sand-4))]">
                    <h3 class="font-semibold tracking-tight text-[var(--color-ink)]">{r.name}</h3>
                    <p class="mt-2 text-sm text-[var(--color-ink-2)]">{r.description}</p>
                    <span class="card-link mt-4 inline-flex">Detail →</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </article>
</BaseLayout>
