---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import VideoCard from '../components/VideoCard.astro';
import videos from '../data/videos.json';
---
<BaseLayout title="Video" description="Galeri video PT. Mardawa Intiguna Persada.">
  <PageHero
    title="Video"
    subtitle="Kumpulan video kegiatan dan company profile kami."
  />
  <section class="py-16 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 sm:grid-cols-2 lg:grid-cols-3">
      {videos.map((v) => (
        <VideoCard
          title={v.title}
          youtubeUrl={v.youtubeUrl}
          description={v.description}
        />
      ))}
    </div>
  </section>
</BaseLayout>
