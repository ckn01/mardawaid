---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('artikel', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---
<BaseLayout title="Artikel" description="Artikel teknologi dan insight dari PT. Mardawa.">
  <PageHero
    title="Artikel"
    subtitle="Tulisan seputar teknologi, web, dan solusi digital."
  />
  <section class="py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4">
      {
        articles.length === 0 ? (
          <EmptyState title="Belum ada artikel" body="Artikel akan ditampilkan di sini." />
        ) : (
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {articles.map((a) => (
              <ArticleCard
                title={a.data.title}
                href={`/artikel/${a.id}`}
                description={a.data.description}
                date={a.data.publishDate.toISOString().slice(0, 10)}
                kategori={a.data.kategori}
              />
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
