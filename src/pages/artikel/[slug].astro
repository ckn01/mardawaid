---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { getSite, waLink } from '../../utils/site';

export async function getStaticPaths() {
  const posts = await getCollection('artikel', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const site = getSite();
const all = (await getCollection('artikel', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const related = all.filter((p) => p.id !== post.id).slice(0, 3);
const dateStr = post.data.publishDate.toISOString().slice(0, 10);
const dateLabel = post.data.publishDate.toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="section">
    <div class="container-site">
      <div class="max-w-3xl">
        <p class="section-label">{post.data.kategori}</p>
        <h1
          class="mt-2 font-[family-name:var(--font-display)] text-[clamp(1.5rem,2.5vw+0.5rem,2.5rem)] font-semibold leading-[1.15] tracking-tight text-[var(--color-ink)]"
          style="font-style: normal; overflow-wrap: anywhere; min-width: 0"
        >
          {post.data.title}
        </h1>
        <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-[var(--color-muted)]">
          <time datetime={dateStr}>{dateLabel}</time>
          <span aria-hidden="true">·</span>
          <span>{site.shortName}</span>
        </div>

        {
          post.data.description && (
            <p class="mt-6 border-l-2 border-[var(--brand)] pl-4 text-[var(--text-lg)] leading-relaxed text-[var(--color-ink-2)]">
              {post.data.description}
            </p>
          )
        }

        <div class="prose prose-article mt-10 max-w-none">
          <Content />
        </div>

        <div class="mt-12 flex flex-wrap items-center gap-4 border-t border-[var(--color-rule)] pt-8">
          <a
            href={waLink(`Halo Admin Mardawa, saya baca artikel "${post.data.title}" dan ingin bertanya.`)}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            Tanya tim kami
          </a>
          <a href="/artikel" class="card-link">← Semua artikel</a>
        </div>
      </div>

      {
        related.length > 0 && (
          <div class="mt-16 border-t border-[var(--color-rule)] pt-12">
            <h2 class="section-title text-xl">Artikel lain</h2>
            <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {related.map((r) => (
                <li>
                  <a
                    href={`/artikel/${r.id}`}
                    class="card block no-underline hover:border-[color-mix(in_srgb,var(--brand)_28%,var(--sand-4))]"
                  >
                    <p class="font-mono text-[0.65rem] uppercase tracking-[0.08em] text-[var(--brand)]">
                      {r.data.kategori}
                    </p>
                    <h3 class="mt-2 font-semibold tracking-tight text-[var(--color-ink)]">{r.data.title}</h3>
                    <p class="mt-2 line-clamp-2 text-sm text-[var(--color-ink-2)]">{r.data.description}</p>
                    <span class="card-link mt-4 inline-flex">Baca →</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </article>
</BaseLayout>
