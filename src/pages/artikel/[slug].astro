---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('artikel', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="section">
    <div class="container-site max-w-3xl">
      <p class="section-label">{post.data.kategori}</p>
      <h1
        class="mt-2 font-[family-name:var(--font-display)] text-[clamp(1.75rem,2.5vw+0.5rem,2.5rem)] font-semibold leading-tight tracking-tight text-[var(--color-ink)]"
        style="font-style: normal"
      >
        {post.data.title}
      </h1>
      <time class="mt-3 block text-sm text-[var(--color-muted)]" datetime={post.data.publishDate.toISOString().slice(0, 10)}>
        {post.data.publishDate.toISOString().slice(0, 10)}
      </time>
      <div class="prose mt-10 max-w-none">
        <Content />
      </div>
      <p class="mt-12">
        <a href="/artikel" class="card-link">← Kembali ke Artikel</a>
      </p>
    </div>
  </article>
</BaseLayout>
