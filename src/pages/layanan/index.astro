---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ProductCard from '../../components/ProductCard.astro';
import services from '../../data/services-portfolio.json';
---
<BaseLayout title="Layanan" description="Portfolio layanan sistem informasi PT. Mardawa.">
  <PageHero
    title="Layanan"
    subtitle="Sistem dan solusi yang kami bangun untuk instansi dan mitra."
  />
  <section class="section">
    <div class="container-site grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <ProductCard
          name={s.name}
          description={s.description}
          href={`/layanan/${s.slug}`}
        />
      ))}
    </div>
  </section>
</BaseLayout>
