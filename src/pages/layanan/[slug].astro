---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import services from '../../data/services.json';
import { waLink } from '../../utils/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;
const highlights = 'highlights' in service && Array.isArray(service.highlights) ? service.highlights : [];
const related = services.filter((s) => s.slug !== service.slug);
---
<BaseLayout title={service.name} description={service.description}>
  <PageHero title={service.name} subtitle="Layanan Mardawa" />
  <article class="section">
    <div class="container-site">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="min-w-0 lg:col-span-7">
          <div class="prose max-w-none">
            <p>{service.description}</p>
          </div>

          {
            highlights.length > 0 && (
              <div class="mt-8">
                <h2 class="text-sm font-semibold tracking-tight text-[var(--color-ink)]">Ringkasan</h2>
                <ul class="mt-3 space-y-2">
                  {highlights.map((h) => (
                    <li class="flex gap-3 text-sm leading-relaxed text-[var(--color-ink-2)]">
                      <span class="mt-2 size-1.5 shrink-0 rounded-full bg-[var(--brand)]" aria-hidden="true" />
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <div class="mt-10 flex flex-wrap items-center gap-4">
            <a
              href={waLink(`Halo Admin Mardawa, saya ingin tahu lebih lanjut tentang layanan ${service.name}.`)}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              Tanya layanan ini
            </a>
            <a href="/layanan" class="card-link">← Semua layanan</a>
          </div>
        </div>

        <aside class="min-w-0 lg:col-span-5">
          <div class="rounded-[var(--radius-card)] border border-[var(--color-rule)] bg-[var(--sand-2)] p-6">
            <p class="font-mono text-[0.65rem] uppercase tracking-[0.08em] text-[var(--sand-9)]">
              Next step
            </p>
            <p class="mt-2 text-lg font-semibold tracking-tight text-[var(--sand-12)]">
              Butuh layanan seperti ini?
            </p>
            <p class="mt-3 text-sm leading-relaxed text-[var(--sand-11)]">
              Ceritakan proses kerja dan target instansi/unit Anda. Kami bantu dari desain hingga implementasi.
            </p>
            <a
              href={waLink(`Halo Admin Mardawa, saya ingin konsultasi layanan ${service.name}.`)}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary mt-6"
            >
              Konsultasi WhatsApp
            </a>
          </div>
        </aside>
      </div>

      {
        related.length > 0 && (
          <div class="mt-16 border-t border-[var(--color-rule)] pt-12">
            <h2 class="section-title text-xl">Layanan lain</h2>
            <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {related.map((r) => (
                <li>
                  <a href={`/layanan/${r.slug}`} class="card block no-underline hover:border-[color-mix(in_srgb,var(--brand)_28%,var(--sand-4))]">
                    <h3 class="font-semibold tracking-tight text-[var(--color-ink)]">{r.name}</h3>
                    <p class="mt-2 text-sm text-[var(--color-ink-2)]">{r.description}</p>
                    <span class="card-link mt-4 inline-flex">Detail →</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </article>
</BaseLayout>
