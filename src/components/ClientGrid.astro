---
interface ClientItem {
  name: string;
  logo?: string | null;
}

interface Props {
  items: ClientItem[];
  /** When true, omit the section chrome (for use under PageHero) */
  bare?: boolean;
}

const { items, bare = false } = Astro.props;
---

<section class:list={[bare ? 'section-tight' : 'section']}>
  <div class="container-site">
    {
      !bare && (
        <div class="max-w-2xl">
          <p class="section-label">Klien</p>
          <h2 class="section-title">Klien kami</h2>
          <p class="mt-3 text-[var(--color-ink-2)]">
            Instansi pendidikan, dinas, dan mitra swasta yang pernah kami dukung.
          </p>
        </div>
      )
    }
    <ul class:list={['grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5', !bare && 'mt-10']}>
      {
        items.map((item) => (
          <li class="flex min-h-[7.5rem] flex-col items-center justify-center gap-3 rounded-[var(--radius-card)] border border-[var(--color-rule)] bg-[var(--color-paper)] px-3 py-5 text-center">
            {item.logo ? (
              <img
                src={item.logo}
                alt={item.name}
                class="h-10 w-auto max-w-full object-contain"
                loading="lazy"
              />
            ) : (
              <span
                class="flex size-10 items-center justify-center rounded-full border border-[var(--color-rule)] bg-[var(--color-paper-2)] text-sm font-semibold text-[var(--color-ink)]"
                aria-hidden="true"
              >
                {item.name.trim().charAt(0).toUpperCase()}
              </span>
            )}
            <span class="text-xs font-medium leading-snug text-[var(--color-ink-2)] sm:text-[0.8rem]">
              {item.name}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
