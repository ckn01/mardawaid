---
interface Props {
  title?: string;
  headline?: string;
  subtitle: string;
  ctaHref: string;
  ctaLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  title = 'PT. Mardawa Intiguna Persada',
  headline = 'Merancang, membangun, dan mengantarkan sistem siap pakai.',
  subtitle,
  ctaHref,
  ctaLabel = 'Hubungi Kami',
  secondaryHref = '/layanan',
  secondaryLabel = 'Lihat Layanan',
} = Astro.props;
---

<section class="hero-solution relative overflow-hidden border-b border-[var(--color-rule)]">
  <div class="hero-solution__glow" aria-hidden="true"></div>
  <div class="hero-solution__grid" aria-hidden="true"></div>

  <div class="container-site relative py-[var(--space-2xl)] lg:py-[var(--space-3xl)]">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 rounded-[var(--radius-pill)] border border-[color-mix(in_srgb,var(--brand)_25%,var(--sand-4))] bg-[var(--brand-soft)] px-3 py-1">
        <span class="size-1.5 rounded-full bg-[var(--brand)]" aria-hidden="true"></span>
        <span class="font-mono text-[0.7rem] font-medium uppercase tracking-[0.08em] text-[var(--brand-dark)]">
          Konsultan IT · Jakarta
        </span>
      </div>

      <p class="mt-5 text-sm font-medium text-[var(--sand-11)]">{title}</p>

      <h1
        class="mt-2 max-w-[18ch] font-[family-name:var(--font-display)] text-[length:var(--text-display)] font-semibold leading-[1.05] tracking-[-0.035em] text-[var(--sand-12)]"
        style="font-style: normal; overflow-wrap: anywhere; min-width: 0"
      >
        {headline}
      </h1>

      <p class="mt-5 max-w-xl text-[var(--text-lg)] leading-relaxed text-[var(--sand-11)]">
        {subtitle}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={ctaHref}
          target={ctaHref.startsWith('http') ? '_blank' : undefined}
          rel={ctaHref.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="btn btn-primary"
        >
          {ctaLabel}
        </a>
        <a href={secondaryHref} class="btn btn-secondary">
          {secondaryLabel}
        </a>
      </div>
    </div>

    <dl class="mt-12 grid grid-cols-2 gap-4 border-t border-[var(--sand-4)] pt-8 sm:grid-cols-3 sm:gap-8 lg:max-w-3xl">
      <div>
        <dt class="font-mono text-[0.65rem] uppercase tracking-[0.08em] text-[var(--sand-9)]">Domain</dt>
        <dd class="mt-1 text-sm font-semibold tracking-tight text-[var(--sand-12)]">Instansi · Pendidikan · Bisnis</dd>
      </div>
      <div>
        <dt class="font-mono text-[0.65rem] uppercase tracking-[0.08em] text-[var(--sand-9)]">Delivery</dt>
        <dd class="mt-1 text-sm font-semibold tracking-tight text-[var(--sand-12)]">Desain · Build · Support</dd>
      </div>
      <div class="col-span-2 sm:col-span-1">
        <dt class="font-mono text-[0.65rem] uppercase tracking-[0.08em] text-[var(--sand-9)]">Fokus</dt>
        <dd class="mt-1 text-sm font-semibold tracking-tight text-[var(--sand-12)]">Sistem siap operasional</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .hero-solution {
    background: var(--sand-1);
  }
  .hero-solution__glow {
    pointer-events: none;
    position: absolute;
    inset: -20% 20% auto -10%;
    height: 70%;
    background:
      radial-gradient(ellipse 60% 50% at 20% 30%, color-mix(in srgb, var(--brand) 16%, transparent), transparent 70%),
      radial-gradient(ellipse 40% 40% at 80% 10%, color-mix(in srgb, var(--brand-theme) 12%, transparent), transparent 65%);
  }
  .hero-solution__grid {
    pointer-events: none;
    position: absolute;
    inset: 0;
    opacity: 0.45;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--sand-5) 70%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--sand-5) 70%, transparent) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 92%);
  }
</style>
