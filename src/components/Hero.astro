---
interface Props {
  title: string;
  subtitle: string;
  ctaHref: string;
  ctaLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  title,
  subtitle,
  ctaHref,
  ctaLabel = 'Hubungi Kami',
  secondaryHref = '/produk',
  secondaryLabel = 'Lihat Portofolio',
} = Astro.props;
---

<section class="section border-b border-[var(--color-rule)]">
  <div class="container-site grid items-end gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-7">
      <p class="section-label">Konsultan IT · Jakarta</p>
      <h1
        class="mt-3 font-[family-name:var(--font-display)] text-[length:var(--text-display)] font-semibold leading-[1.05] tracking-[-0.035em] text-[var(--color-ink)]"
        style="font-style: normal"
      >
        {title}
      </h1>
      <p class="mt-5 max-w-xl text-[var(--text-lg)] leading-relaxed text-[var(--color-ink-2)]">
        {subtitle}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={ctaHref}
          target={ctaHref.startsWith('http') ? '_blank' : undefined}
          rel={ctaHref.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="btn btn-primary"
        >
          {ctaLabel}
        </a>
        <a href={secondaryHref} class="btn btn-secondary">
          {secondaryLabel}
        </a>
      </div>
    </div>

    <aside class="lg:col-span-5">
      <div class="rounded-[var(--radius-card)] border border-[var(--color-rule)] bg-[var(--color-paper-2)] p-6 md:p-8">
        <p class="section-label">Fokus layanan</p>
        <ul class="mt-4 space-y-4">
          <li class="flex gap-3 border-b border-[var(--color-rule)] pb-4">
            <span class="font-mono text-xs text-[var(--color-muted)]">01</span>
            <div>
              <p class="font-semibold tracking-tight text-[var(--color-ink)]">Website & portal</p>
              <p class="mt-1 text-sm text-[var(--color-ink-2)]">Portal institusi yang rapi dan terukur.</p>
            </div>
          </li>
          <li class="flex gap-3 border-b border-[var(--color-rule)] pb-4">
            <span class="font-mono text-xs text-[var(--color-muted)]">02</span>
            <div>
              <p class="font-semibold tracking-tight text-[var(--color-ink)]">Sistem informasi</p>
              <p class="mt-1 text-sm text-[var(--color-ink-2)]">SIM untuk operasional & manajerial.</p>
            </div>
          </li>
          <li class="flex gap-3">
            <span class="font-mono text-xs text-[var(--color-muted)]">03</span>
            <div>
              <p class="font-semibold tracking-tight text-[var(--color-ink)]">Mobile & data</p>
              <p class="mt-1 text-sm text-[var(--color-ink-2)]">Aplikasi Android dan integrasi data warehouse.</p>
            </div>
          </li>
        </ul>
      </div>
    </aside>
  </div>
</section>
