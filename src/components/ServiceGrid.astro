---
interface ServiceItem {
  name: string;
  description: string;
  icon?: string;
}

interface Props {
  items: ServiceItem[];
}

const { items } = Astro.props;
---

<section class="section bg-[var(--color-paper-2)]">
  <div class="container-site">
    <div class="max-w-2xl">
      <p class="section-label">Layanan</p>
      <h2 class="section-title">Pelayanan kami</h2>
      <p class="mt-3 text-[var(--color-ink-2)]">
        Empat jalur kerja utama — dari portal publik sampai integrasi data.
      </p>
    </div>

    <ol class="mt-10 grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-rule)] bg-[var(--color-rule)] sm:grid-cols-2">
      {
        items.map((item, i) => (
          <li class="bg-[var(--color-paper)] p-6 md:p-8">
            <span class="font-mono text-xs text-[var(--color-muted)]">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 text-lg font-semibold tracking-tight text-[var(--color-ink)]">
              {item.name}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-2)]">
              {item.description}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
