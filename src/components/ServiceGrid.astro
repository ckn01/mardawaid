---
interface ServiceItem {
  name: string;
  description: string;
  icon?: string;
}

interface Props {
  items: ServiceItem[];
}

const { items } = Astro.props;
---

<section class="py-16 md:py-20 bg-sand-2">
  <div class="mx-auto max-w-6xl px-4">
    <p class="text-sm font-semibold uppercase tracking-wide text-primary">Layanan</p>
    <h2 class="mt-2 text-2xl font-semibold md:text-3xl">Pelayanan Kami</h2>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((item) => (
          <li class="rounded-2xl border border-sand-3 bg-white p-6 shadow-sm transition hover:shadow-md">
            <div
              class="mb-4 flex size-10 items-center justify-center rounded-lg bg-primary/10 text-primary"
              aria-hidden="true"
            >
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <rect x="3" y="4" width="18" height="14" rx="2" />
                <path d="M8 20h8M12 18v2" stroke-linecap="round" />
              </svg>
            </div>
            <h3 class="text-base font-semibold text-sand-12">{item.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-sand-12/70">{item.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
