---
interface TeamItem {
  name: string;
  title: string;
}

interface Props {
  items: TeamItem[];
}

const { items } = Astro.props;
---

<section class="py-16 md:py-20">
  <div class="mx-auto max-w-6xl px-4">
    <p class="text-sm font-semibold uppercase tracking-wide text-primary">Tim</p>
    <h2 class="mt-2 text-2xl font-semibold md:text-3xl">Struktur Organisasi</h2>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item) => (
          <li class="rounded-2xl border border-sand-3 bg-white p-6 shadow-sm transition hover:shadow-md">
            <span
              class="mb-4 flex size-12 items-center justify-center rounded-full bg-primary/10 text-lg font-semibold text-primary"
              aria-hidden="true"
            >
              {item.name.trim().charAt(0).toUpperCase()}
            </span>
            <h3 class="text-base font-semibold text-sand-12">{item.name}</h3>
            <p class="mt-1 text-sm text-sand-12/70">{item.title}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
