---
interface TeamItem {
  name: string;
  title: string;
}

interface Props {
  items: TeamItem[];
}

const { items } = Astro.props;
---

<section class="section">
  <div class="container-site">
    <div class="max-w-2xl">
      <p class="section-label">Tim</p>
      <h2 class="section-title">Struktur organisasi</h2>
    </div>
    <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item) => (
          <li class="flex items-start gap-4 rounded-[var(--radius-card)] border border-[var(--color-rule)] bg-[var(--color-paper)] p-5">
            <span
              class="flex size-11 shrink-0 items-center justify-center rounded-full border border-[var(--color-rule)] bg-[var(--color-paper-2)] text-sm font-semibold text-[var(--color-ink)]"
              aria-hidden="true"
            >
              {item.name.trim().charAt(0).toUpperCase()}
            </span>
            <div class="min-w-0">
              <h3 class="font-semibold tracking-tight text-[var(--color-ink)]">{item.name}</h3>
              <p class="mt-0.5 text-sm text-[var(--color-ink-2)]">{item.title}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
