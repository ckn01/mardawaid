---
interface Props {
  name: string;
  href: string;
  description?: string;
  type?: string;
  url?: string | null;
}

const typeLabel: Record<string, string> = {
  sistem: 'Sistem',
  aplikasi: 'Aplikasi',
  'web-sekolah': 'Web sekolah',
};

const { name, href, description, type, url } = Astro.props;
const label = type && typeLabel[type] ? typeLabel[type] : 'Produk';
const dataType = type ?? 'produk';

// Initials for the visual header (first letter of each word, max 2)
const initials = name
  .split(/\s+/)
  .filter((w) => !/^(web|sekolah|sistem|aplikasi|negeri|unggulan|yayasan|boarding|school)$/i.test(w))
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase() ?? '')
  .join('') || name.slice(0, 2).toUpperCase();

let host: string | null = null;
if (url) {
  try {
    host = new URL(url).hostname.replace(/^www\./, '');
  } catch {
    host = null;
  }
}
---

<article data-type={dataType} class="group card min-w-0 !p-0 overflow-hidden">
  <!-- Visual gradient header -->
  <div class="relative flex h-32 items-center justify-center overflow-hidden bg-[linear-gradient(135deg,var(--brand)_0%,var(--brand-mid)_55%,var(--brand-dark)_100%)]">
    <div
      class="pointer-events-none absolute inset-0 opacity-30"
      aria-hidden="true"
      style="background-image: linear-gradient(to right, rgb(255 255 255 / 0.18) 1px, transparent 1px), linear-gradient(to bottom, rgb(255 255 255 / 0.18) 1px, transparent 1px); background-size: 28px 28px;"
    >
    </div>
    <div
      class="pointer-events-none absolute -right-8 -top-8 size-28 rounded-full bg-white/15 blur-xl"
      aria-hidden="true"
    >
    </div>
    <span class="relative font-[family-name:var(--font-display)] text-3xl font-semibold tracking-tight text-white drop-shadow-sm">
      {initials}
    </span>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <span class="mb-2 inline-flex w-fit rounded-full bg-[var(--brand-soft)] px-2.5 py-1 font-mono text-[0.65rem] font-medium uppercase tracking-[0.08em] text-[var(--brand-dark)]">
      {label}
    </span>
    <h3 class="text-base sm:text-lg font-semibold tracking-tight text-[var(--color-ink)]" style="overflow-wrap: anywhere; min-width: 0">
      <a href={href} class="transition-colors hover:text-[var(--color-accent)]">
        {name}
      </a>
    </h3>
    {
      description && (
        <p class="mt-2 flex-1 text-xs sm:text-sm leading-relaxed text-[var(--color-ink-2)]">
          {description}
        </p>
      )
    }
    {
      host && (
        <p class="mt-3 truncate font-mono text-[0.7rem] text-[var(--color-muted)]">
          {host}
        </p>
      )
    }
    <a href={href} class="card-link mt-4 inline-flex items-center gap-1 self-start">
      Detail
      <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
    </a>
  </div>
</article>
