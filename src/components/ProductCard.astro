---
interface Props {
  name: string;
  href: string;
  description?: string;
}

const { name, href, description } = Astro.props;
---

<article class="card">
  <h3 class="text-lg font-semibold tracking-tight text-[var(--color-ink)]">
    <a href={href} class="hover:text-[var(--color-accent)]">
      {name}
    </a>
  </h3>
  {
    description && (
      <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-ink-2)] line-clamp-4">
        {description}
      </p>
    )
  }
  <a href={href} class="card-link mt-5">
    Detail →
  </a>
</article>
