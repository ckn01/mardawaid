---
interface Props {
  name: string;
  href: string;
  description?: string;
}

const { name, href, description } = Astro.props;
---

<article class="flex h-full flex-col rounded-2xl border border-sand-3 bg-white p-6 shadow-sm transition hover:shadow-md">
  <h3 class="text-lg font-semibold text-sand-12">
    <a href={href} class="hover:text-primary">
      {name}
    </a>
  </h3>
  {
    description && (
      <p class="mt-2 flex-1 text-sm leading-relaxed text-sand-12/70">{description}</p>
    )
  }
  <a href={href} class="mt-4 inline-flex text-sm font-semibold text-primary hover:text-primary-dark">
    Lihat detail →
  </a>
</article>
