---
import { getSite, mailtoLink, waLink } from '../utils/site';

const site = getSite();
const year = new Date().getFullYear();

const quickLinks = [
  { label: 'Tentang', href: '/tentang-kami' },
  { label: 'Klien', href: '/klien' },
  { label: 'Produk', href: '/produk' },
  { label: 'Layanan', href: '/layanan' },
  { label: 'Artikel', href: '/artikel' },
];
---

<footer class="mt-auto border-t border-[var(--sand-4)] bg-[var(--sand-2)]">
  <div class="container-site py-[var(--space-2xl)]">
    <p class="font-mono text-[0.7rem] font-medium uppercase tracking-[0.1em] text-[var(--brand)]">
      {site.positioning}
    </p>
    <p class="mt-3 max-w-2xl font-[family-name:var(--font-display)] text-[clamp(1.35rem,2vw+0.5rem,1.85rem)] font-semibold leading-snug tracking-tight text-[var(--sand-12)]">
      Solusi IT yang jelas, terukur, dan siap dipakai instansi maupun bisnis.
    </p>
    <p class="mt-3 max-w-xl text-sm leading-relaxed text-[var(--sand-11)]">
      {site.tagline}
    </p>

    <div class="mt-10 flex flex-col gap-8 border-t border-[var(--sand-4)] pt-8 md:flex-row md:items-start md:justify-between">
      <nav aria-label="Tautan footer">
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm font-medium text-[var(--sand-11)] hover:text-[var(--brand)]"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
        <li>
          <a href={mailtoLink()} class="text-[var(--sand-11)] hover:text-[var(--brand)]">{site.email}</a>
        </li>
        <li>
          <a href={waLink()} target="_blank" rel="noopener noreferrer" class="text-[var(--sand-11)] hover:text-[var(--brand)]">
            WhatsApp
          </a>
        </li>
        <li>
          <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" class="text-[var(--sand-11)] hover:text-[var(--brand)]">
            Instagram
          </a>
        </li>
        <li>
          <a href={site.social.youtube} target="_blank" rel="noopener noreferrer" class="text-[var(--sand-11)] hover:text-[var(--brand)]">
            YouTube
          </a>
        </li>
      </ul>
    </div>

    <p class="mt-10 text-xs text-[var(--sand-9)]">
      © {year} {site.name} · IT Solution
    </p>
  </div>
</footer>
