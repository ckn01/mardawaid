---
interface PortfolioItem {
  name: string;
  description: string;
  href: string;
  kind: string;
}

interface Props {
  products: PortfolioItem[];
  services: PortfolioItem[];
}

const { products, services } = Astro.props;
const items = [...services, ...products].slice(0, 6);
---

<section class="section">
  <div class="container-site">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <p class="section-label">Portofolio</p>
        <h2 class="section-title">Yang sudah kami bangun</h2>
        <p class="mt-3 text-[var(--color-ink-2)]">
          Sistem instansi, aplikasi layanan, dan web sekolah — bukti kerja, bukan sekadar katalog fitur.
        </p>
      </div>
      <div class="flex flex-wrap gap-4">
        <a href="/produk" class="card-link">Semua produk →</a>
        <a href="/layanan" class="card-link">Semua layanan →</a>
      </div>
    </div>

    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item) => (
          <li class="min-w-0">
            <a
              href={item.href}
              class="card group block no-underline transition hover:border-[color-mix(in_srgb,var(--brand)_28%,var(--sand-4))]"
            >
              <p class="font-mono text-[0.65rem] font-medium uppercase tracking-[0.08em] text-[var(--brand)]">
                {item.kind}
              </p>
              <h3
                class="mt-2 text-lg font-semibold tracking-tight text-[var(--color-ink)] group-hover:text-[var(--brand)]"
                style="overflow-wrap: anywhere; min-width: 0"
              >
                {item.name}
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-ink-2)]">
                {item.description}
              </p>
              <span class="card-link mt-5 inline-flex">Detail →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
