---
interface Props {
  title: string;
  alamat: string;
  src: string;
}

const { title, alamat, src } = Astro.props;
---

<div class="overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-rule)] bg-[var(--color-paper)]">
  <div class="p-5">
    <h3 class="font-semibold tracking-tight text-[var(--color-ink)]">{title}</h3>
    <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-2)]">{alamat}</p>
  </div>
  <div class="aspect-video w-full border-t border-[var(--color-rule)] bg-[var(--color-paper-2)]">
    <iframe
      src={src}
      title={`Peta ${title}`}
      class="size-full border-0"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    />
  </div>
</div>
