---
import { getSite, waLink, mailtoLink } from '../utils/site';

const site = getSite();
---

<section class="section">
  <div class="container-site">
    <div class="relative overflow-hidden rounded-[calc(var(--radius-card)+4px)] border border-[var(--color-accent)] bg-[var(--color-accent)] px-6 py-12 text-[var(--color-accent-ink)] md:px-12 md:py-16">
      <div class="relative max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.08em] text-[oklch(99%_0_0_/_0.7)]">Langkah berikutnya</p>
        <h2 class="mt-3 font-[family-name:var(--font-display)] text-[clamp(1.5rem,2vw+0.75rem,2.25rem)] font-semibold leading-tight tracking-tight">
          Siap memulai?
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-[oklch(99%_0_0_/_0.88)] md:text-base">
          Diskusikan kebutuhan IT Anda dengan {site.shortName}. Tim kami siap bantu via WhatsApp atau email.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={waLink()}
            target="_blank"
            rel="noopener noreferrer"
            class="btn bg-[var(--color-paper)] text-[var(--color-accent)] hover:bg-[var(--color-paper-2)]"
          >
            WhatsApp
          </a>
          <a href={mailtoLink()} class="btn btn-ghost-on-accent">
            Email
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
