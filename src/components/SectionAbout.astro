---
interface Props {
  description: string;
}

const { description } = Astro.props;
---

<section class="section">
  <div class="container-site">
    <p class="section-label">Tentang</p>
    <h2 class="section-title">Siapa kamis</h2>
    <p class="mt-5 max-w-[var(--measure)] text-[var(--text-lg)] leading-relaxed text-[var(--sand-11)]">
      {description}
    </p>
    <div class="mt-8 grid max-w-100% gap-3 sm:grid-cols-3">
      <div class="rounded-[var(--radius-card)] border border-[var(--sand-4)] bg-[var(--sand-2)] px-4 py-3">
        <p class="font-mono text-[0.65rem] uppercase tracking-[0.08em] text-[var(--brand)]">01</p>
        <p class="mt-1 text-sm font-semibold text-[var(--sand-12)]">Pahami kebutuhan</p>
      </div>
      <div class="rounded-[var(--radius-card)] border border-[var(--sand-4)] bg-[var(--sand-2)] px-4 py-3">
        <p class="font-mono text-[0.65rem] uppercase tracking-[0.08em] text-[var(--brand)]">02</p>
        <p class="mt-1 text-sm font-semibold text-[var(--sand-12)]">Rancang & bangun</p>
      </div>
      <div class="rounded-[var(--radius-card)] border border-[var(--sand-4)] bg-[var(--sand-2)] px-4 py-3">
        <p class="font-mono text-[0.65rem] uppercase tracking-[0.08em] text-[var(--brand)]">03</p>
        <p class="mt-1 text-sm font-semibold text-[var(--sand-12)]">Serah-terima & dampingi</p>
      </div>
    </div>
    <a href="/tentang-kami" class="card-link mt-6 inline-flex">
      Selengkapnya tentang Mardawa →
    </a>
  </div>
</section>
