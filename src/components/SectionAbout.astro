---
interface Props {
  description: string;
}

const { description } = Astro.props;
---

<section class="section">
  <div class="container-site grid gap-8 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-4">
      <p class="section-label">Tentang</p>
      <h2 class="section-title">Siapa kami</h2>
    </div>
    <div class="lg:col-span-8">
      <p class="max-w-[var(--measure)] text-[var(--text-lg)] leading-relaxed text-[var(--color-ink-2)]">
        {description}
      </p>
      <a href="/tentang-kami" class="card-link mt-6 inline-flex">
        Selengkapnya tentang Mardawa →
      </a>
    </div>
  </div>
</section>
