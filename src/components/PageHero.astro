---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="border-b border-[var(--color-rule)] bg-[var(--color-paper-2)] section-tight">
  <div class="container-site max-w-3xl">
    <h1
      class="font-[family-name:var(--font-display)] text-[clamp(1.85rem,3vw+0.5rem,2.75rem)] font-semibold leading-[1.1] tracking-[-0.03em] text-[var(--color-ink)]"
      style="font-style: normal"
    >
      {title}
    </h1>
    {
      subtitle && (
        <p class="mt-3 max-w-[var(--measure)] text-[var(--text-lg)] leading-relaxed text-[var(--color-ink-2)]">
          {subtitle}
        </p>
      )
    }
  </div>
</section>
