---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="section-tight relative overflow-hidden border-b border-[var(--sand-4)] bg-[var(--sand-2)]">
  <div
    class="pointer-events-none absolute inset-0 opacity-40"
    style="background: radial-gradient(ellipse 50% 80% at 100% 0%, color-mix(in srgb, var(--brand) 14%, transparent), transparent 60%);"
    aria-hidden="true"
  ></div>
  <div class="container-site relative max-w-3xl">
    <h1
      class="font-[family-name:var(--font-display)] text-[clamp(1.85rem,3vw+0.5rem,2.75rem)] font-semibold leading-[1.1] tracking-[-0.03em] text-[var(--sand-12)]"
      style="font-style: normal"
    >
      {title}
    </h1>
    {
      subtitle && (
        <p class="mt-3 max-w-[var(--measure)] text-[var(--text-lg)] leading-relaxed text-[var(--sand-11)]">
          {subtitle}
        </p>
      )
    }
  </div>
</section>
