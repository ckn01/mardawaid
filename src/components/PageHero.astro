---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="border-b border-sand-3 bg-sand-2 py-12 md:py-16">
  <div class="mx-auto max-w-6xl px-4">
    <h1 class="text-3xl font-semibold tracking-tight text-sand-12 md:text-4xl">
      {title}
    </h1>
    {
      subtitle && (
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-sand-12/70 md:text-lg">
          {subtitle}
        </p>
      )
    }
  </div>
</section>
