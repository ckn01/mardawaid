---
/*
 * ServiceCategoryBar — a filterable row of category tiles shown above the
 * product grid. The first tile is always "Semua" (All) and is active by
 * default. Clicking a tile filters the linked product grid via the tiny
 * inline script at the bottom, which toggles product cards by their
 * `data-type` attribute.
 */
interface Category {
  /** label shown on the tile */
  name: string;
  description?: string;
  icon: 'all' | 'system' | 'website' | 'mobile' | 'data';
  /** maps to the product `type` value this tile filters; omit for "Semua" */
  type?: string;
  /** number of matching products, shown as a small count badge */
  count?: number;
}

interface Props {
  items: Category[];
  /** noun used in the live count (e.g. "produk", "layanan"); defaults to "produk" */
  itemLabel?: string;
}

const { items, itemLabel = 'produk' } = Astro.props;
---

<div
  class="grid gap-4 grid-cols-2 lg:grid-cols-5"
  data-category-bar
>
  {
    items.map((item, i) => {
      const active = i === 0;
      const Tag = 'button';
      return (
        <Tag
          type="button"
          data-type={item.type ?? 'all'}
          aria-pressed={active ? 'true' : 'false'}
          class:list={[
            'sc-tile group flex flex-col items-start gap-4 rounded-[var(--radius-card)] border p-6 text-left transition',
            'duration-[var(--dur-short)] ease-[var(--ease-out)]',
            active && 'is-active',
          ]}
        >
          <div class="flex w-full items-center justify-between gap-2">
            <span
              class:list={[
                'sc-icon flex size-12 shrink-0 items-center justify-center rounded-full transition',
                'bg-[var(--brand-soft)] text-[var(--brand-dark)] group-hover:bg-[color-mix(in_srgb,var(--brand)_18%,var(--brand-soft))]',
              ]}
              aria-hidden="true"
            >
              {item.icon === 'all' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-6">
                  <rect x="3" y="3" width="7" height="7" rx="1.5" />
                  <rect x="14" y="3" width="7" height="7" rx="1.5" />
                  <rect x="3" y="14" width="7" height="7" rx="1.5" />
                  <rect x="14" y="14" width="7" height="7" rx="1.5" />
                </svg>
              )}
              {item.icon === 'system' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-6">
                  <rect x="3" y="3" width="7" height="7" rx="1.5" />
                  <rect x="14" y="3" width="7" height="7" rx="1.5" />
                  <rect x="3" y="14" width="7" height="7" rx="1.5" />
                  <path d="M14 17.5h7M17.5 14v7" />
                </svg>
              )}
              {item.icon === 'website' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-6">
                  <rect x="2.5" y="4" width="19" height="13" rx="2" />
                  <path d="M2.5 8h19M6 6.5h-.01M8.5 6.5h-.01" />
                  <path d="M9 21h6M12 17v4" />
                </svg>
              )}
              {item.icon === 'mobile' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-6">
                  <rect x="7" y="2.5" width="10" height="19" rx="2.5" />
                  <path d="M11 18.5h2" />
                </svg>
              )}
              {item.icon === 'data' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-6">
                  <ellipse cx="12" cy="5.5" rx="7.5" ry="3" />
                  <path d="M4.5 5.5v6c0 1.66 3.36 3 7.5 3s7.5-1.34 7.5-3v-6" />
                  <path d="M4.5 11.5v6c0 1.66 3.36 3 7.5 3s7.5-1.34 7.5-3v-6" />
                </svg>
              )}
            </span>
            {item.count != null && (
              <span
                class:list={[
                  'sc-badge shrink-0 rounded-full px-2.5 py-1 font-mono text-[0.65rem] font-medium tabular-nums transition',
                  'bg-[var(--sand-3)] text-[var(--color-ink-2)]',
                ]}
              >
                {item.count}
              </span>
            )}
          </div>

          <div class="min-w-0">
            <h3 class="text-sm font-semibold tracking-tight">{item.name}</h3>
            {item.description && (
              <p class="sc-caption mt-1.5 text-xs leading-relaxed text-[var(--color-ink-2)]">
                {item.description}
              </p>
            )}
          </div>
        </Tag>
      );
    })
  }
</div>

<style>
  /* inactive tile */
  .sc-tile {
    border: 1px solid var(--color-rule);
    background: var(--color-paper);
  }
  .sc-tile:hover {
    border-color: color-mix(in srgb, var(--brand) 28%, var(--sand-4));
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
  }

  /* active tile — dark gradient */
  .sc-tile.is-active {
    border-color: transparent;
    background: linear-gradient(135deg, #0b1f33 0%, #103251 55%, var(--brand-dark) 100%);
    color: #fff;
    box-shadow: var(--shadow-soft);
  }
  .sc-tile.is-active:hover {
    transform: none;
  }

  /* children adapt to active state */
  .sc-tile.is-active .sc-icon {
    background: rgb(255 255 255 / 0.15);
    color: #fff;
  }
  .sc-tile.is-active .sc-badge {
    background: rgb(255 255 255 / 0.2);
    color: #fff;
  }
  .sc-tile.is-active .sc-caption {
    color: rgb(255 255 255 / 0.85);
  }
</style>

<script>
  const bar = document.querySelector('[data-category-bar]');
  const grid = document.querySelector('[data-product-grid]');
  if (bar && grid) {
    const tiles = Array.from(bar.querySelectorAll<HTMLButtonElement>('button[data-type]'));
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-type]'));
    const counter = document.querySelector<HTMLElement>('[data-product-count]');

    tiles.forEach((tile) => {
      tile.addEventListener('click', () => {
        const type = tile.dataset.type;
        // toggle active state
        tiles.forEach((t) => {
          const on = t === tile;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        // filter cards
        let shown = 0;
        cards.forEach((card) => {
          const match = type === 'all' || card.dataset.type === type;
          card.hidden = !match;
          if (match) shown++;
        });
        if (counter) counter.textContent = `${shown} ${counter.dataset.itemLabel ?? 'produk'}`;
      });
    });
  }
</script>
