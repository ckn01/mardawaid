---
interface Props {
  title: string;
  href: string;
  description?: string;
  date?: string;
  kategori?: string;
}

const { title, href, description, date, kategori } = Astro.props;
---

<article class="card">
  <div class="mb-3 flex flex-wrap items-center gap-2 text-xs text-[var(--color-muted)]">
    {kategori && <span class="font-mono uppercase tracking-wide text-[var(--color-accent)]">{kategori}</span>}
    {date && <time datetime={date}>{date}</time>}
  </div>
  <h3 class="text-lg font-semibold tracking-tight text-[var(--color-ink)]">
    <a href={href} class="hover:text-[var(--color-accent)]">
      {title}
    </a>
  </h3>
  {
    description && (
      <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-ink-2)]">{description}</p>
    )
  }
  <a href={href} class="card-link mt-5">
    Baca →
  </a>
</article>
