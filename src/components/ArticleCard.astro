---
interface Props {
  title: string;
  href: string;
  description?: string;
  date?: string;
  kategori?: string;
}

const { title, href, description, date, kategori } = Astro.props;
---

<article class="flex h-full flex-col rounded-2xl border border-sand-3 bg-white p-6 shadow-sm transition hover:shadow-md">
  <div class="mb-3 flex flex-wrap items-center gap-2 text-xs text-sand-12/60">
    {kategori && <span class="font-semibold uppercase tracking-wide text-primary">{kategori}</span>}
    {date && <time datetime={date}>{date}</time>}
  </div>
  <h3 class="text-lg font-semibold text-sand-12">
    <a href={href} class="hover:text-primary">
      {title}
    </a>
  </h3>
  {
    description && (
      <p class="mt-2 flex-1 text-sm leading-relaxed text-sand-12/70">{description}</p>
    )
  }
  <a href={href} class="mt-4 inline-flex text-sm font-semibold text-primary hover:text-primary-dark">
    Baca selengkapnya →
  </a>
</article>
