---
import { getSite, waLink } from '../utils/site';

const site = getSite();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
  const h = href.replace(/\/$/, '') || '/';
  if (h === '/') return path === '/';
  return path === h || path.startsWith(`${h}/`);
}

function parentActive(children: { href: string }[]): boolean {
  return children.some((c) => isActive(c.href));
}
---

<header class="sticky top-0 z-40 px-3 pt-3 md:px-4 md:pt-4">
  <div
    class="container-site flex items-center justify-between gap-3 rounded-[var(--radius-pill)] border border-[var(--color-rule)] bg-[color-mix(in_oklch,var(--color-paper)_88%,transparent)] px-3 py-2 shadow-[var(--shadow-soft)] backdrop-blur-md md:px-4"
  >
    <a href="/" class="group min-w-0 shrink-0 leading-tight px-1" aria-label={site.name}>
      <span class="block text-sm font-semibold tracking-tight text-[var(--color-ink)] sm:text-[0.95rem]">
        PT. Mardawa
      </span>
      <span class="block text-[0.7rem] text-[var(--color-ink-2)] sm:text-xs">Intiguna Persada</span>
    </a>

    <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Navigasi utama">
      {
        site.nav.map((item) =>
          item.children ? (
            <details class="group relative">
              <summary
                class:list={[
                  'cursor-pointer list-none rounded-[var(--radius-pill)] px-3 py-2 text-sm font-medium marker:content-none [&::-webkit-details-marker]:hidden',
                  parentActive(item.children)
                    ? 'bg-[var(--color-paper-3)] font-semibold text-[var(--color-accent)]'
                    : 'text-[var(--color-ink-2)] hover:bg-[var(--color-paper-2)] hover:text-[var(--color-ink)]',
                ]}
              >
                <span class="inline-flex items-center gap-1">
                  {item.label}
                  <svg class="size-3.5 opacity-50 transition group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                  </svg>
                </span>
              </summary>
              <ul class="absolute left-0 top-full z-50 mt-2 min-w-48 rounded-[var(--radius-card)] border border-[var(--color-rule)] bg-[var(--color-paper)] py-1 shadow-[var(--shadow-soft)]">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class:list={[
                        'block px-4 py-2.5 text-sm',
                        isActive(child.href)
                          ? 'font-semibold text-[var(--color-accent)]'
                          : 'text-[var(--color-ink-2)] hover:bg-[var(--color-paper-2)] hover:text-[var(--color-ink)]',
                      ]}
                      aria-current={isActive(child.href) ? 'page' : undefined}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a
              href={item.href}
              class:list={[
                'rounded-[var(--radius-pill)] px-3 py-2 text-sm font-medium',
                isActive(item.href!)
                  ? 'bg-[var(--color-paper-3)] font-semibold text-[var(--color-accent)]'
                  : 'text-[var(--color-ink-2)] hover:bg-[var(--color-paper-2)] hover:text-[var(--color-ink)]',
              ]}
              aria-current={isActive(item.href!) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ),
        )
      }
      <a href={waLink()} target="_blank" rel="noopener noreferrer" class="btn btn-primary ml-2 !min-h-9 !px-4 !py-2 text-sm">
        Hubungi Kami
      </a>
    </nav>

    <div class="flex items-center gap-2 lg:hidden">
      <a
        href={waLink()}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary !min-h-9 !px-3 !py-2 text-xs sm:text-sm"
      >
        Hubungi
      </a>
      <details class="relative">
        <summary
          class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full border border-[var(--color-rule)] bg-[var(--color-paper)] marker:content-none [&::-webkit-details-marker]:hidden"
          aria-label="Buka menu"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
          </svg>
        </summary>
        <nav
          class="absolute right-0 top-full z-50 mt-2 w-[min(18rem,calc(100vw-1.5rem))] rounded-[var(--radius-card)] border border-[var(--color-rule)] bg-[var(--color-paper)] py-2 shadow-[var(--shadow-soft)]"
          aria-label="Navigasi mobile"
        >
          <ul class="flex flex-col">
            {
              site.nav.flatMap((item) =>
                item.children
                  ? item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class:list={[
                            'block px-4 py-2.5 text-sm',
                            isActive(child.href)
                              ? 'font-semibold text-[var(--color-accent)]'
                              : 'text-[var(--color-ink-2)] hover:bg-[var(--color-paper-2)]',
                          ]}
                          aria-current={isActive(child.href) ? 'page' : undefined}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))
                  : [
                      <li>
                        <a
                          href={item.href}
                          class:list={[
                            'block px-4 py-2.5 text-sm',
                            isActive(item.href!)
                              ? 'font-semibold text-[var(--color-accent)]'
                              : 'text-[var(--color-ink-2)] hover:bg-[var(--color-paper-2)]',
                          ]}
                          aria-current={isActive(item.href!) ? 'page' : undefined}
                        >
                          {item.label}
                        </a>
                      </li>,
                    ],
              )
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
