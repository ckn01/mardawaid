---
import { youtubeThumb } from '../utils/youtube';

interface Props {
  title: string;
  youtubeUrl: string;
  description?: string;
}

const { title, youtubeUrl, description } = Astro.props;
const thumb = youtubeThumb(youtubeUrl);
---

<a
  href={youtubeUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="group card !p-0 overflow-hidden"
>
  <div class="relative aspect-video overflow-hidden bg-[var(--color-paper-3)]">
    <img
      src={thumb}
      alt=""
      class="size-full object-cover transition duration-[var(--dur-short)] group-hover:scale-[1.02]"
      loading="lazy"
    />
    <span
      class="absolute inset-0 flex items-center justify-center bg-[oklch(22%_0.012_80_/_0.25)]"
      aria-hidden="true"
    >
      <span class="flex size-12 items-center justify-center rounded-full bg-[var(--color-paper)] text-[var(--color-ink)] shadow-[var(--shadow-soft)]">
        <svg class="ml-0.5 size-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5v14l11-7L8 5z" />
        </svg>
      </span>
    </span>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-base font-semibold tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-accent)]">
      {title}
    </h3>
    {
      description && (
        <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-[var(--color-ink-2)]">{description}</p>
      )
    }
  </div>
</a>
