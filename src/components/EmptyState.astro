---
interface Props {
  title: string;
  body?: string;
}

const { title, body } = Astro.props;
---

<div class="flex flex-col items-start rounded-[var(--radius-card)] border border-dashed border-[var(--color-rule)] bg-[var(--color-paper-2)] px-6 py-12 md:px-10 md:py-16">
  <p class="section-label">Kosong</p>
  <h2 class="mt-2 text-lg font-semibold tracking-tight text-[var(--color-ink)] md:text-xl">{title}</h2>
  {
    body && (
      <p class="mt-2 max-w-md text-sm leading-relaxed text-[var(--color-ink-2)]">{body}</p>
    )
  }
</div>
